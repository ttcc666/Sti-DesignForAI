<Window x:Class="StiLabel.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:StiLabel.App.Views"
        Title="{Binding Title}"
        Width="1360" Height="860"
        MinWidth="1080" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}">
    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding NewLabelCommand}"/>
        <KeyBinding Key="O" Modifiers="Ctrl" Command="{Binding OpenCommand}"/>
        <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding SaveCommand}"/>
        <KeyBinding Key="S" Modifiers="Ctrl+Shift" Command="{Binding SaveAsCommand}"/>
        <KeyBinding Key="P" Modifiers="Ctrl" Command="{Binding PreviewLabelCommand}"/>
        <KeyBinding Key="P" Modifiers="Ctrl+Shift" Command="{Binding PrintLabelCommand}"/>
        <KeyBinding Key="Escape" Command="{Binding StopChatCommand}"/>
    </Window.InputBindings>
    <DockPanel>

        <!-- ============ 顶栏 ============ -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Surface}"
                BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
            <DockPanel Margin="14,0" Height="52">

                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="28" Height="28" CornerRadius="8">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#6366F1" Offset="0"/>
                                <GradientStop Color="#8B5CF6" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="S" Foreground="White" FontSize="15" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="STI 标签工位" FontSize="14" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="10,0,4,0"/>
                    <Border Background="{StaticResource SurfaceSunken}" CornerRadius="5" Padding="6,2"
                            VerticalAlignment="Center" Margin="6,0,0,0">
                        <TextBlock Text="AI Agent" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextMuted}"/>
                    </Border>
                    <Border Width="1" Background="{StaticResource Line}" Margin="14,14" />
                    <Menu VerticalAlignment="Center">
                        <MenuItem Header="文件">
                            <MenuItem Header="新建" Command="{Binding NewLabelCommand}" InputGestureText="Ctrl+N"/>
                            <MenuItem Header="打开..." Command="{Binding OpenCommand}" InputGestureText="Ctrl+O"/>
                            <MenuItem Header="保存" Command="{Binding SaveCommand}" InputGestureText="Ctrl+S"/>
                            <MenuItem Header="另存为..." Command="{Binding SaveAsCommand}" InputGestureText="Ctrl+Shift+S"/>
                            <Separator/>
                            <MenuItem Header="导出 PDF..." Command="{Binding ExportPdfCommand}"/>
                            <MenuItem Header="导出 PNG..." Command="{Binding ExportPngCommand}"/>
                            <Separator/>
                            <MenuItem Header="最近打开" ItemsSource="{Binding RecentFiles}">
                                <MenuItem.ItemContainerStyle>
                                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                        <Setter Property="Header" Value="{Binding}"/>
                                        <Setter Property="Command" Value="{Binding DataContext.OpenRecentCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        <Setter Property="CommandParameter" Value="{Binding}"/>
                                    </Style>
                                </MenuItem.ItemContainerStyle>
                            </MenuItem>
                            <Separator/>
                            <MenuItem Header="退出" Click="Exit_Click"/>
                        </MenuItem>
                        <MenuItem Header="打印机">
                            <MenuItem Header="刷新本机队列" Command="{Binding RefreshPrintersCommand}"/>
                            <MenuItem Header="预览" Command="{Binding PreviewLabelCommand}" InputGestureText="Ctrl+P"/>
                            <MenuItem Header="打样" Command="{Binding PrintLabelCommand}" InputGestureText="Ctrl+Shift+P"
                                      IsEnabled="{Binding CanPrint}"/>
                        </MenuItem>
                        <MenuItem Header="版本">
                            <MenuItem Header="另存一版" Command="{Binding SaveVersionCommand}"/>
                            <MenuItem Header="查看历史" ItemsSource="{Binding VersionFiles}">
                                <MenuItem.ItemContainerStyle>
                                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                        <Setter Property="Header" Value="{Binding Name}"/>
                                        <Setter Property="Command" Value="{Binding DataContext.OpenVersionCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        <Setter Property="CommandParameter" Value="{Binding Path}"/>
                                        <Setter Property="ToolTip" Value="{Binding Path}"/>
                                    </Style>
                                </MenuItem.ItemContainerStyle>
                            </MenuItem>
                        </MenuItem>
                        <MenuItem Header="帮助">
                            <MenuItem Header="快捷键" Click="Shortcuts_Click"/>
                            <MenuItem Header="关于" Click="About_Click"/>
                        </MenuItem>
                    </Menu>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource GhostButton}" Command="{Binding OpenSettingsCommand}"
                            ToolTip="切换厂商、模型和密钥">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,7,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource TextSubtle}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsChatEnabled}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource Success}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding StatusModel}" VerticalAlignment="Center" FontSize="12"/>
                        </StackPanel>
                    </Button>
                    <Button Content="模型设置" Style="{StaticResource SecondaryButton}"
                            Margin="8,0,0,0" Command="{Binding OpenSettingsCommand}"/>
                </StackPanel>

                <Grid/>
            </DockPanel>
        </Border>

        <!-- ============ 底部状态条 ============ -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Surface}"
                BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" Margin="16,0" Height="30" VerticalAlignment="Center">
                <TextBlock Text="{Binding StatusFile}" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                <TextBlock Text="·" Style="{StaticResource Caption}" Margin="10,0" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding StatusPage}" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                <TextBlock Text="·" Style="{StaticResource Caption}" Margin="10,0" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding StatusPrinter}" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                <TextBlock Text="·" Style="{StaticResource Caption}" Margin="10,0" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding StatusModel}" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                <TextBlock Text="·" Style="{StaticResource Caption}" Margin="10,0" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding StatusDirty}" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- ============ 工作区 ============ -->
        <Grid Margin="12,12,12,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding ChatPaneWidth}"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*" MinWidth="380"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="296" MinWidth="240"/>
            </Grid.ColumnDefinitions>

            <!-- 对话 -->
            <Border Grid.Column="0" Style="{StaticResource Card}" CornerRadius="16" ClipToBounds="True">
                <Grid>

                    <!-- 收起态：细窄导轨 -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,14"
                                Visibility="{Binding ChatCollapsed, Converter={StaticResource BoolVis}}">
                        <Button Style="{StaticResource ChatIconButton}"
                                Command="{Binding ToggleChatCommand}" ToolTip="展开对话">
                            <Path Data="M8,5 L15,12 L8,19" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        </Button>
                        <Border Width="32" Height="32" CornerRadius="10" Background="{StaticResource ChatInk}" Margin="0,14,0,0">
                            <Path Data="{StaticResource SparkleGeometry}" Fill="White" Width="16" Height="16"
                                  Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="助手" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,14,0,0"
                                   HorizontalAlignment="Center">
                            <TextBlock.LayoutTransform>
                                <RotateTransform Angle="90"/>
                            </TextBlock.LayoutTransform>
                        </TextBlock>
                    </StackPanel>

                    <!-- 展开态 -->
                    <DockPanel Visibility="{Binding ChatCollapsed, Converter={StaticResource InverseBoolVis}}">

                        <Border DockPanel.Dock="Top" Padding="12,10,10,6" Background="Transparent">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                    <Button Style="{StaticResource ChatIconButton}"
                                            Command="{Binding NewChatCommand}"
                                            ToolTip="丢掉当前对话记忆，从头开始">
                                        <Path Data="{StaticResource GridGeometry}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              Width="15" Height="15" Stretch="Uniform"/>
                                    </Button>
                                    <Button Style="{StaticResource ChatIconButton}"
                                            Command="{Binding ToggleChatCommand}" ToolTip="收起对话">
                                        <Path Data="{StaticResource CloseGeometry}"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.6" StrokeStartLineCap="Round" Width="14" Height="14" Stretch="Uniform"/>
                                    </Button>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                            Visibility="{Binding IsWelcomeState, Converter={StaticResource InverseBoolVis}}">
                                    <Border Width="28" Height="28" CornerRadius="8" Background="{StaticResource ChatInk}">
                                        <Path Data="{StaticResource SparkleGeometry}" Fill="White" Width="14" Height="14"
                                              Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="标签助手" FontSize="14" FontWeight="SemiBold"
                                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- 未启用时的引导条 -->
                        <Border DockPanel.Dock="Top" Background="#FFF8E7" CornerRadius="10" Padding="12,9" Margin="14,0,14,6"
                                Visibility="{Binding IsChatEnabled, Converter={StaticResource InverseBoolVis}}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="去设置" Style="{StaticResource AccentChipButton}"
                                        VerticalAlignment="Center" Margin="10,0,0,0"
                                        Command="{Binding OpenSettingsCommand}"/>
                                <TextBlock Text="{Binding AgentBanner}" Style="{StaticResource Caption}"
                                           Foreground="#8A6D1F" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>

                        <StackPanel DockPanel.Dock="Top" Margin="16,2,16,6"
                                    ToolTip="本轮发给模型的输入 token / 设置的上下文上限">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsChatEnabled}" Value="True"/>
                                                <Condition Binding="{Binding IsWelcomeState}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right"
                                           Text="{Binding ContextUsagePercentText}"
                                           FontSize="10" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextMuted}"/>
                                <TextBlock Text="{Binding ContextUsageText}"
                                           FontSize="10"
                                           Foreground="{StaticResource TextSubtle}"/>
                            </DockPanel>
                            <ProgressBar Height="4" Margin="0,4,0,0" Minimum="0" Maximum="100"
                                         Value="{Binding ContextUsagePercent, Mode=OneWay}"
                                         BorderThickness="0"
                                         Background="{StaticResource Line}">
                                <ProgressBar.Style>
                                    <Style TargetType="ProgressBar">
                                        <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ContextUsageLevel}" Value="warn">
                                                <Setter Property="Foreground" Value="#D97706"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ContextUsageLevel}" Value="high">
                                                <Setter Property="Foreground" Value="#B42318"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ProgressBar.Style>
                            </ProgressBar>
                        </StackPanel>

                        <!-- 输入区 -->
                        <Border DockPanel.Dock="Bottom" Margin="14,8,14,14" Padding="14,12,14,10"
                                Background="{StaticResource Surface}"
                                BorderBrush="{StaticResource Line}" BorderThickness="1"
                                CornerRadius="16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <ItemsControl Grid.Row="0" ItemsSource="{Binding PendingImages}"
                                              Visibility="{Binding HasPendingImages, Converter={StaticResource BoolVis}}"
                                              Margin="0,0,0,10">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="56" Height="56" Margin="0,0,6,0" CornerRadius="10"
                                                    BorderBrush="{StaticResource Line}" BorderThickness="1"
                                                    ClipToBounds="True">
                                                <Grid>
                                                    <Image Source="{Binding Preview}" Stretch="UniformToFill"/>
                                                    <Button Content="×" Width="18" Height="18" Padding="0"
                                                            FontSize="10"
                                                            HorizontalAlignment="Right" VerticalAlignment="Top"
                                                            Style="{StaticResource TinyButton}"
                                                            Command="{Binding DataContext.RemovePendingImageCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0" Data="{StaticResource SearchGeometry}"
                                          Stroke="{StaticResource ChatHint}" StrokeThickness="1.6"
                                          Width="16" Height="16" Stretch="Uniform"
                                          VerticalAlignment="Top" Margin="0,7,8,0"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <TextBox x:Name="ChatInputBox" Grid.Column="1"
                                             Style="{StaticResource FlatTextBox}"
                                             Tag="问我任何问题..."
                                             Text="{Binding ChatInput, UpdateSourceTrigger=PropertyChanged}"
                                             TextWrapping="Wrap" MaxHeight="120"
                                             VerticalScrollBarVisibility="Auto"
                                             IsEnabled="{Binding IsChatEnabled}"
                                             PreviewKeyDown="ChatInput_PreviewKeyDown"
                                             AcceptsReturn="True"
                                             AllowDrop="True" PreviewDragOver="ChatInput_PreviewDragOver"
                                             Drop="ChatInput_Drop"/>
                                    <Button Grid.Column="2" Style="{StaticResource SendButton}" Content="↑"
                                            VerticalAlignment="Top" Margin="8,0,0,0"
                                            Command="{Binding SendChatCommand}"
                                            IsEnabled="{Binding IsChatEnabled}" ToolTip="发送"
                                            Visibility="{Binding IsBusy, Converter={StaticResource InverseBoolVis}}"/>
                                    <Button Grid.Column="2" Style="{StaticResource StopButton}" Content="■"
                                            VerticalAlignment="Top" Margin="8,0,0,0"
                                            Command="{Binding StopChatCommand}"
                                            ToolTip="停止生成"
                                            Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}"/>
                                </Grid>

                                <Border Grid.Row="2" Height="1" Background="{StaticResource Line}" Margin="0,10,0,8"/>
                                <DockPanel Grid.Row="3">
                                    <ComboBox DockPanel.Dock="Left"
                                              Style="{StaticResource PillComboBox}"
                                              IsEditable="True"
                                              IsEnabled="{Binding CanSwitchModel}"
                                              ItemsSource="{Binding ModelChoices}"
                                              Text="{Binding SelectedChatModel, UpdateSourceTrigger=LostFocus}"
                                              ToolTip="即时切换模型，下一句生效"/>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock VerticalAlignment="Center" Margin="0,0,8,0"
                                                   Style="{StaticResource Caption}" Foreground="{StaticResource Accent}"
                                                   Text="正在生成…"
                                                   Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}"/>
                                        <Button Style="{StaticResource ComposerLinkButton}"
                                                Command="{Binding AttachImageCommand}"
                                                IsEnabled="{Binding IsChatEnabled}" ToolTip="发送图片，可拖图或 Ctrl+V">
                                            <TextBlock Text="@ 附图" FontWeight="SemiBold"/>
                                        </Button>
                                    </StackPanel>
                                    <Grid/>
                                </DockPanel>
                            </Grid>
                        </Border>

                        <!-- 欢迎页 -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      Visibility="{Binding IsWelcomeState, Converter={StaticResource BoolVis}}">
                            <Border MinHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                                <StackPanel VerticalAlignment="Center" Margin="22,8,22,8">
                                    <Border Width="48" Height="48" CornerRadius="14" Background="{StaticResource ChatInk}"
                                            HorizontalAlignment="Center">
                                        <Path Data="{StaticResource SparkleGeometry}" Fill="White" Width="22" Height="22"
                                              Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="你好，" FontSize="15" HorizontalAlignment="Center"
                                               Margin="0,18,0,0" Foreground="{StaticResource ChatInk}"/>
                                    <TextBlock Text="欢迎回来，需要做什么？" FontSize="20" FontWeight="Bold"
                                               TextAlignment="Center" TextWrapping="Wrap"
                                               Margin="0,4,0,0" Foreground="{StaticResource ChatInk}"/>
                                    <TextBlock Text="{Binding WelcomeSubtitle}"
                                               FontSize="12" TextAlignment="Center" TextWrapping="Wrap"
                                               Margin="8,10,8,18" Foreground="{StaticResource TextMuted}"
                                               LineHeight="18"/>

                                    <UniformGrid Columns="2">
                                        <Button Style="{StaticResource PromptPill}" Margin="0,0,6,8" Background="#E8F1FE"
                                                Command="{Binding UsePromptCommand}"
                                                CommandParameter="做一张 70×40 物料标签，要物料编码、品名、批次、QR">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="18" Height="18" CornerRadius="5" Background="#3B82F6" Margin="0,0,8,0">
                                                    <Path Data="M3,6 H15 V16 H3 Z M6,6 L8,3 H12 L14,6"
                                                          Stroke="White" StrokeThickness="1.2" Width="12" Height="12"
                                                          Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="做物料标签" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource PromptPill}" Margin="6,0,0,8" Background="#FFF1E6"
                                                Command="{Binding UsePromptCommand}"
                                                CommandParameter="看看当前字段够不够，还缺什么，怎么排更清楚">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="18" Height="18" CornerRadius="5" Background="#F97316" Margin="0,0,8,0">
                                                    <Path Data="M4,16 V10 H7 V16 Z M9,16 V6 H12 V16 Z M14,16 V12 H17 V16 Z"
                                                          Fill="White" Width="12" Height="12" Stretch="Uniform"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="分析字段" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource PromptPill}" Margin="0,0,6,8" Background="#E8F8EE"
                                                Command="{Binding UsePromptCommand}"
                                                CommandParameter="按现在这张标签给一个改版计划，先说要动哪些地方">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="18" Height="18" CornerRadius="5" Background="#22C55E" Margin="0,0,8,0">
                                                    <Path Data="M4,6 H16 M4,11 H16 M4,16 H12"
                                                          Stroke="White" StrokeThickness="1.6" Width="12" Height="12"
                                                          Stretch="Uniform" StrokeStartLineCap="Round"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="做改版计划" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource PromptPill}" Margin="6,0,0,8" Background="#FDE8F2"
                                                Command="{Binding UsePromptCommand}"
                                                CommandParameter="用两三句话说明这张标签给谁用、印什么">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="18" Height="18" CornerRadius="5" Background="#EC4899" Margin="0,0,8,0">
                                                    <Path Data="M4,6 H16 M4,11 H16 M4,16 H13"
                                                          Stroke="White" StrokeThickness="1.6" Width="12" Height="12"
                                                          Stretch="Uniform" StrokeStartLineCap="Round"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="汇总说明" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource PromptPill}" Margin="0,0,6,0" Background="#FBF3D5"
                                                Command="{Binding UsePromptCommand}"
                                                CommandParameter="给这张标签写一版简洁的标题和字段说明">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="18" Height="18" CornerRadius="5" Background="#EAB308" Margin="0,0,8,0">
                                                    <Path Data="M5,15 L7,9 L13,3 L17,7 L11,13 Z"
                                                          Stroke="White" StrokeThickness="1.3" Width="12" Height="12"
                                                          Stretch="Uniform" StrokeLineJoin="Round"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="帮我写文案" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource PromptPill}" Margin="6,0,0,0" Background="#F1E8FE"
                                                Command="{Binding UsePromptCommand}"
                                                CommandParameter="还有哪些改进建议？尺寸、条码、对齐都可以说">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="18" Height="18" CornerRadius="5" Background="#8B5CF6" Margin="0,0,8,0">
                                                    <Path Data="{StaticResource GridGeometry}" Fill="White" Width="11" Height="11"
                                                          Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="更多建议" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>
                        </ScrollViewer>

                        <!-- 消息流 -->
                        <ListBox x:Name="ChatList" ItemsSource="{Binding Messages}"
                                 Style="{StaticResource PlainListBox}" Padding="4,4,4,8"
                                 VirtualizingPanel.IsVirtualizing="False"
                                 ScrollViewer.CanContentScroll="False"
                                 ScrollViewer.PanningMode="VerticalOnly"
                                 Visibility="{Binding IsWelcomeState, Converter={StaticResource InverseBoolVis}}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="14,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border x:Name="Avatar" Grid.Column="0"
                                                Width="26" Height="26" CornerRadius="8"
                                                Background="{StaticResource ChatInk}"
                                                VerticalAlignment="Top" Margin="0,1,10,0">
                                            <Path Data="{StaticResource SparkleGeometry}" Fill="White" Width="13" Height="13"
                                                  Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <StackPanel Grid.Column="1">
                                            <ItemsControl x:Name="Pics" ItemsSource="{Binding Images}"
                                                          Visibility="{Binding HasImages, Converter={StaticResource BoolVis}}"
                                                          Margin="0,0,0,6" HorizontalAlignment="Left">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border MaxWidth="140" MaxHeight="96" Margin="0,0,6,0"
                                                                CornerRadius="10" ClipToBounds="True">
                                                            <Image Source="{Binding Preview}" Stretch="Uniform"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <StackPanel x:Name="ToolChips"
                                                        Visibility="{Binding HasTools, Converter={StaticResource BoolVis}}"
                                                        Margin="0,0,0,6" HorizontalAlignment="Left">
                                                <TextBlock Text="调用工具" FontSize="10"
                                                           Foreground="{StaticResource TextSubtle}" Margin="0,0,0,4"/>
                                                <ItemsControl ItemsSource="{Binding Tools}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="{StaticResource AccentSoft}"
                                                                    BorderBrush="{StaticResource AccentLine}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="999" Padding="8,2" Margin="0,0,6,4">
                                                                <TextBlock Text="{Binding}" FontSize="10"
                                                                           Foreground="{StaticResource Accent}"/>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                            <Border x:Name="Bubble"
                                                    Background="{StaticResource ChatInkSoft}"
                                                    BorderBrush="Transparent" BorderThickness="0"
                                                    CornerRadius="4,16,16,16" Padding="13,10"
                                                    HorizontalAlignment="Left">
                                                <TextBlock x:Name="BubbleText" Text="{Binding Text}"
                                                           TextWrapping="Wrap" LineHeight="20"
                                                           Foreground="{StaticResource ChatInk}"/>
                                            </Border>
                                            <WrapPanel x:Name="Actions" Margin="0,8,0,0">
                                                <Button Content="确认应用" Margin="0,0,6,0"
                                                        Style="{StaticResource AccentChipButton}"
                                                        Visibility="{Binding NeedsConfirm, Converter={StaticResource BoolVis}}"
                                                        Command="{Binding DataContext.ConfirmChatCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Content="应用到画布" Margin="0,0,6,0"
                                                        Style="{StaticResource AccentChipButton}"
                                                        Visibility="{Binding CanApply, Converter={StaticResource BoolVis}}"
                                                        Command="{Binding DataContext.ApplyChatCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Content="撤销本次"
                                                        Style="{StaticResource TinyButton}"
                                                        Visibility="{Binding CanUndo, Converter={StaticResource BoolVis}}"
                                                        Command="{Binding DataContext.UndoChatCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Content="重发"
                                                        Style="{StaticResource AccentChipButton}"
                                                        Visibility="{Binding CanRetry, Converter={StaticResource BoolVis}}"
                                                        Command="{Binding DataContext.ResendChatCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Grid>

                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Role}" Value="用户">
                                            <Setter TargetName="Avatar" Property="Visibility" Value="Collapsed"/>
                                            <Setter TargetName="Pics" Property="HorizontalAlignment" Value="Right"/>
                                            <Setter TargetName="Bubble" Property="Background" Value="{StaticResource ChatInk}"/>
                                            <Setter TargetName="Bubble" Property="BorderBrush" Value="{StaticResource ChatInk}"/>
                                            <Setter TargetName="Bubble" Property="CornerRadius" Value="16,16,4,16"/>
                                            <Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Right"/>
                                            <Setter TargetName="Bubble" Property="MaxWidth" Value="300"/>
                                            <Setter TargetName="BubbleText" Property="Foreground" Value="White"/>
                                            <Setter TargetName="Actions" Property="Visibility" Value="Collapsed"/>
                                            <Setter TargetName="ToolChips" Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="10" HorizontalAlignment="Stretch" ShowsPreview="True"/>

            <!-- 画布 -->
            <Border Grid.Column="2" Style="{StaticResource Card}" CornerRadius="12" ClipToBounds="True">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="{StaticResource SurfaceAlt}"
                            CornerRadius="12,12,0,0" Padding="16,11"
                            BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
                        <DockPanel>
                            <Border DockPanel.Dock="Right" Background="{StaticResource Surface}"
                                    BorderBrush="{StaticResource Line}" BorderThickness="1"
                                    CornerRadius="5" Padding="7,3" VerticalAlignment="Center">
                                <TextBlock Text="{Binding StatusPage}" FontSize="11"
                                           Foreground="{StaticResource TextMuted}"/>
                            </Border>
                            <StackPanel>
                                <TextBlock Text="画布 · Stimulsoft WinForms 设计器" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0"
                                           Text="对话和「按所选生成草稿」都会编译进这份报表。许可文件放 %AppData%\StiLabel\license.key。"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <views:StiDesignerHost x:Name="DesignerHost"/>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="3" Width="10" HorizontalAlignment="Stretch" ShowsPreview="True"/>

            <!-- 右侧检查器 -->
            <Border Grid.Column="4" Style="{StaticResource Card}" ClipToBounds="True">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,2,0">
                    <StackPanel Margin="16,16,14,18">

                        <!-- 字段 -->
                        <DockPanel>
                            <Border DockPanel.Dock="Right" Background="{StaticResource SurfaceSunken}"
                                    CornerRadius="9" Padding="7,2" VerticalAlignment="Center">
                                <TextBlock FontSize="11" Foreground="{StaticResource TextMuted}"
                                           Text="{Binding Fields.Count, StringFormat={}{0} 项}"/>
                            </Border>
                            <TextBlock Text="字段" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                        </DockPanel>
                        <TextBlock Style="{StaticResource Caption}" Margin="0,5,0,0"
                                   Text="只对当前模板有效。新建会清空；打开模板会读入该模板里的字段。"/>

                        <DockPanel Margin="0,10,0,0">
                            <Button DockPanel.Dock="Right" Content="添加" Width="54" Margin="8,0,0,0"
                                    Command="{Binding AddFieldCommand}"/>
                            <TextBox Text="{Binding NewFieldName, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="新字段名">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Return" Command="{Binding AddFieldCommand}"/>
                                </TextBox.InputBindings>
                            </TextBox>
                        </DockPanel>

                        <ItemsControl ItemsSource="{Binding Fields}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="Row" Background="Transparent" CornerRadius="7"
                                            Padding="7,5" Margin="0,1">
                                        <DockPanel>
                                            <Button x:Name="Del" DockPanel.Dock="Right" Content="✕"
                                                    Style="{StaticResource TinyButton}" Margin="6,0,0,0"
                                                    Padding="7,2" Opacity="0" ToolTip="删除字段"
                                                    Command="{Binding DataContext.RemoveFieldCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>
                                            <Border DockPanel.Dock="Right" VerticalAlignment="Center"
                                                    Background="{StaticResource SuccessSoft}" CornerRadius="5"
                                                    Padding="6,1" Margin="6,0,0,0"
                                                    Visibility="{Binding Bound, Converter={StaticResource BoolVis}}">
                                                <TextBlock FontSize="10" Foreground="{StaticResource Success}"
                                                           Text="{Binding Bound, Converter={StaticResource BoundTextConverter}}"/>
                                            </Border>
                                            <CheckBox Content="{Binding DisplayName}"
                                                      IsChecked="{Binding Selected, Mode=TwoWay}"
                                                      VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="{StaticResource Hover}"/>
                                            <Setter TargetName="Del" Property="Opacity" Value="1"/>
                                        </Trigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button Content="按所选生成草稿" Margin="0,12,0,0" Height="34"
                                Command="{Binding GenerateDraftCommand}"/>
                        <Button Content="插入图片" Margin="0,8,0,0" Style="{StaticResource SecondaryButton}"
                                Command="{Binding InsertImageCommand}"/>

                        <Border Height="1" Background="{StaticResource Line}" Margin="0,18"/>

                        <!-- 页规格 -->
                        <TextBlock Text="页规格" Style="{StaticResource SectionTitle}"/>
                        <ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}"
                                  Margin="0,8,0,0"/>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <DockPanel Grid.Column="0">
                                <TextBlock Text="宽" Style="{StaticResource Caption}" Width="16"
                                           VerticalAlignment="Center"/>
                                <TextBox Style="{StaticResource FlatTextBox}"
                                         Text="{Binding PageWidthMm, UpdateSourceTrigger=LostFocus}"/>
                            </DockPanel>
                            <DockPanel Grid.Column="2">
                                <TextBlock Text="高" Style="{StaticResource Caption}" Width="16"
                                           VerticalAlignment="Center"/>
                                <TextBox Style="{StaticResource FlatTextBox}"
                                         Text="{Binding PageHeightMm, UpdateSourceTrigger=LostFocus}"/>
                            </DockPanel>
                        </Grid>
                        <DockPanel Margin="0,8,0,0">
                            <TextBlock Text="边距" Style="{StaticResource Caption}" Width="32"
                                       VerticalAlignment="Center"/>
                            <TextBox Style="{StaticResource FlatTextBox}"
                                     Text="{Binding PageMarginMm, UpdateSourceTrigger=LostFocus}"/>
                        </DockPanel>
                        <CheckBox Content="横向" IsChecked="{Binding PageLandscape}" Margin="0,8,0,0"/>
                        <Button Content="应用到当前稿" Margin="0,8,0,0" Style="{StaticResource SecondaryButton}"
                                Command="{Binding ApplyPresetCommand}"/>

                        <Border Height="1" Background="{StaticResource Line}" Margin="0,18"/>

                        <!-- 打印机 -->
                        <TextBlock Text="打印机" Style="{StaticResource SectionTitle}"/>
                        <ComboBox ItemsSource="{Binding Printers}" SelectedItem="{Binding SelectedPrinter}"
                                  Margin="0,8,0,0"/>

                        <Border Height="1" Background="{StaticResource Line}" Margin="0,18"/>

                        <!-- 示例数据 -->
                        <TextBlock Text="示例数据" Style="{StaticResource SectionTitle}"/>
                        <Border Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource Line}"
                                BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,8,0,0">
                            <TextBlock Text="{Binding SampleSummary}" Style="{StaticResource Caption}"/>
                        </Border>
                        <Button Content="预览" Margin="0,10,0,0" Style="{StaticResource SecondaryButton}"
                                Command="{Binding PreviewLabelCommand}"/>
                        <Button Content="打样" Margin="0,8,0,0" Height="34"
                                Command="{Binding PrintLabelCommand}"
                                IsEnabled="{Binding CanPrint}"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</Window>
