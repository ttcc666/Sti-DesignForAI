<UserControl x:Class="StiLabel.App.Views.LabelSurface"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Viewbox Stretch="Uniform">
        <Border x:Name="Paper"
                Background="#FFFFFF"
                BorderBrush="{StaticResource Line}"
                BorderThickness="1"
                CornerRadius="2"
                Effect="{StaticResource ShadowSoft}">
            <Canvas x:Name="Board" />
        </Border>
    </Viewbox>
</UserControl>
