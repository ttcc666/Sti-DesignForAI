<Window x:Class="StiLabel.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="模型接入"
        Width="880" Height="700"
        MinWidth="780" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Topmost="True"
        ShowInTaskbar="False"
        Background="{StaticResource Bg}">
    <Window.Resources>
        <Style x:Key="ProviderItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8"
                                Padding="9,7" Margin="0,1" SnapsToDevicePixels="True">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Hover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoft}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
    </Window.Resources>

    <DockPanel>

        <!-- 顶部 -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Surface}"
                BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="20,14">
            <StackPanel>
                <TextBlock Text="模型接入" FontSize="15" FontWeight="SemiBold"/>
                <TextBlock Style="{StaticResource Caption}" Margin="0,3,0,0"
                           Text="左边选厂商会按官网默认填好地址和请求格式。OpenAI、Anthropic、Gemini、Azure OpenAI、Ollama 都走各自官方 SDK，换厂商不影响已有对话能力。"/>
            </StackPanel>
        </Border>

        <!-- 底部 -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Surface}"
                BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="20,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="取消" Style="{StaticResource GhostButton}" Width="72" IsCancel="True"/>
                    <Button Content="测连通" Style="{StaticResource SecondaryButton}" Width="88"
                            Margin="8,0,0,0" Click="Test_Click"/>
                    <Button Content="保存并启用" Width="110" Margin="8,0,0,0" IsDefault="True" Click="Save_Click"/>
                </StackPanel>
                <CheckBox x:Name="EnableBox" Content="启用对话" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <Grid Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="262"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 厂商列表 -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="14,11" BorderBrush="{StaticResource Line}"
                            BorderThickness="0,0,0,1" Background="{StaticResource SurfaceAlt}"
                            CornerRadius="12,12,0,0">
                        <TextBlock Text="厂商" Style="{StaticResource SectionTitle}"/>
                    </Border>
                    <ListBox x:Name="ProviderList" BorderThickness="0" Background="Transparent"
                             Padding="7,7,4,7" ItemContainerStyle="{StaticResource ProviderItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="Provider_Changed">
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextSubtle}" Margin="9,12,0,4"/>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <Border DockPanel.Dock="Left" Width="26" Height="26" CornerRadius="7"
                                            Background="{Binding Accent}" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Badge}" Foreground="White" FontSize="10"
                                                   FontWeight="Bold" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="12"/>
                                        <TextBlock Text="{Binding Caption}" FontSize="10"
                                                   Foreground="{StaticResource TextSubtle}"
                                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- 表单 -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20,18,18,20">

                        <DockPanel>
                            <Border DockPanel.Dock="Left" x:Name="ProviderBadge" Width="34" Height="34"
                                    CornerRadius="9" Background="{StaticResource Accent}" Margin="0,0,12,0"
                                    VerticalAlignment="Top">
                                <TextBlock x:Name="ProviderBadgeText" Text="AI" Foreground="White" FontSize="12"
                                           FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Button DockPanel.Dock="Right" x:Name="ConsoleLink" Content="拿密钥 ↗"
                                    Style="{StaticResource TinyButton}" VerticalAlignment="Top"
                                    Foreground="{StaticResource Accent}" Click="Console_Click"/>
                            <StackPanel>
                                <TextBlock x:Name="ProviderName" Text="OpenAI" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock x:Name="ProviderNote" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                            </StackPanel>
                        </DockPanel>

                        <Border Height="1" Background="{StaticResource Line}" Margin="0,16"/>

                        <TextBlock Text="请求格式" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="ProtocolBox" DisplayMemberPath="Name"
                                  SelectionChanged="Protocol_Changed"/>
                        <TextBlock x:Name="ProtocolNote" Style="{StaticResource Caption}" Margin="0,6,0,0"/>

                        <TextBlock Text="接口地址" Style="{StaticResource FieldLabel}" Margin="0,18,0,6"/>
                        <TextBox x:Name="EndpointBox" Tag="https://api.example.com/v1"/>
                        <TextBlock x:Name="EndpointNote" Style="{StaticResource Caption}" Margin="0,6,0,0"/>

                        <TextBlock Text="模型" Style="{StaticResource FieldLabel}" Margin="0,18,0,6"/>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" x:Name="FetchButton" Content="拉取列表"
                                    Style="{StaticResource SecondaryButton}" Width="88" Margin="8,0,0,0"
                                    Click="Fetch_Click"/>
                            <ComboBox x:Name="ModelBox" IsEditable="True"/>
                        </DockPanel>
                        <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0"
                                   Text="下拉里是常见模型名，也可以直接手输。填好地址和密钥后点「拉取列表」能读到该厂商真实可用的模型。"/>

                        <TextBlock Text="API Key" Style="{StaticResource FieldLabel}" Margin="0,18,0,6"/>
                        <PasswordBox x:Name="KeyBox"/>
                        <TextBlock x:Name="KeyHint" Style="{StaticResource Caption}" Margin="0,6,0,0"/>

                        <TextBlock Text="上下文上限" Style="{StaticResource FieldLabel}" Margin="0,18,0,6"/>
                        <ComboBox x:Name="ContextBox" IsEditable="True"/>
                        <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0"
                                   Text="按模型窗口填。超过这个 token 预算才压缩。常见 8K～128K，也可以手输数字。"/>

                        <TextBlock Text="上下文压缩" Style="{StaticResource FieldLabel}" Margin="0,18,0,6"/>
                        <ComboBox x:Name="CompactBox" DisplayMemberPath="Name"
                                  SelectionChanged="Compact_Changed"/>
                        <TextBlock x:Name="CompactNote" Style="{StaticResource Caption}" Margin="0,6,0,0"/>

                        <StackPanel x:Name="TurnsPanel" Margin="0,18,0,0" Visibility="Collapsed">
                            <TextBlock Text="保留轮数" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="TurnsBox" IsEditable="True"/>
                            <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0"
                                       Text="滑动窗口只留最近这几轮用户对话，更早的丢掉。"/>
                        </StackPanel>

                        <Border x:Name="StatusStrip" CornerRadius="8" Padding="12,9" Margin="0,18,0,0"
                                Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource Line}"
                                BorderThickness="1" Visibility="Collapsed">
                            <TextBlock x:Name="TestResult" TextWrapping="Wrap" FontSize="12"/>
                        </Border>

                        <Border Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource Line}"
                                BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,18,0,0">
                            <StackPanel>
                                <TextBlock Text="说明" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextMuted}"/>
                                <TextBlock Style="{StaticResource Caption}" Margin="0,5,0,0"
                                           Text="助手要靠工具调用来改画布，所以请选支持 function calling 的模型。厂商不支持时会自动退回纯文字回复。请求由各厂商官方 SDK 发出，协议细节不用你管。密钥只存在本机 SQLite 里。"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</Window>
