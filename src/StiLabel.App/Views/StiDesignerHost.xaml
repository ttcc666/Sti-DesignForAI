<UserControl x:Class="StiLabel.App.Views.StiDesignerHost"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:StiLabel.App.Views">
    <Grid>
        <WindowsFormsHost x:Name="FormsHost"/>
        <DockPanel x:Name="FallbackPanel" Visibility="Collapsed">
            <TextBlock x:Name="FallbackHint"
                       DockPanel.Dock="Top"
                       Margin="8"
                       TextWrapping="Wrap"
                       Foreground="#5E6772"/>
            <Button DockPanel.Dock="Bottom" Content="用官方设计器窗口打开" Margin="8" Height="32"
                    Click="OpenDialogDesigner_Click"/>
            <views:LabelSurface x:Name="FallbackSurface" Margin="8"/>
        </DockPanel>
    </Grid>
</UserControl>
